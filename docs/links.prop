📁 dotfiles-win/  
│  
├── 📄 README.md                # Overview, setup instructions  
├── 📄 LICENSE  
│  
├── 📁 configs/                 # Main configurations  
│   ├── 📁 registry/            # .reg files for settings  
│   │   ├── 📄 config.reg  
│   │  
│   ├── 📁 powershell/          # PS Profile configurations  
│   │   ├── 📄 Microsoft.Powershell_Profile.ps1
│   │   └── 📄 powershell.config.json
│   │  
│   ├── 📁 winget/              # Winget package lists  
│   │   ├── 📄 apps.json        # Winget import/export  
│   │   └── 📄 config.yml       # Winget config (Win11 22H2+)  
│   │  
│   └── 📁 chocolatey/          # Choco packages  
│       └── 📄 packages.config  
│  
├── 📁 scripts/                 # Automation scripts  
│   ├── 📄 install.ps1          # Main setup script  
│   ├── 📄 backup.ps1           # Backup current configs  
│   └── 📄 restore.ps1          # Restore from backup  
│  
├── 📁 env/                     # Environment variables  
│   ├── 📄 path-additions.txt   # Custom PATH entries  
│   └── 📄 env-vars.ps1         # PS script to set variables  
│  
├── 📁 terminal/                # Terminal setups  
│   ├── 📄 setting.json         # WT settings  
│   └── 📄 profile.ps1          # PowerShell $PROFILE  
│  
└── 📁 docs/                    # Documentation  
    ├── 📄 gpo-guide.md         # Group Policy tweaks  
    └── 📄 manual-steps.md      # GUI-only settings  
